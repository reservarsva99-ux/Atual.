local TweenService = game:GetService("TweenService")
local v1 = game.ReplicatedStorage.Events["Countdown Competition"]
local v2 = script.Parent
local CompTimer = v2.CompTimer
local Countdown = v2.Countdown
local v3 = TweenService:Create(CompTimer, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
	Position = UDim2.new(0.504, 0, -0.245, 0)
})
local v4 = TweenService:Create(CompTimer, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
	Position = UDim2.new(0.504, 0, 0.635, 0)
})
local v5 = UDim2.new(0.504, 0, 1.505, 0)

local function StartCountdown() --[[ StartCountdown | Line: 15 | Upvalues: Countdown (copy), CompTimer (copy), v5 (copy), v4 (copy), v3 (copy) ]]
	Countdown:Play()
	CompTimer.Visible = true

	for i = 3, 1, -1 do
		CompTimer.Position = v5
		CompTimer.Text = i
		v4:Play()
		task.wait(0.9)
		v3:Play()
		task.wait(0.1)
	end

	CompTimer.Visible = false
