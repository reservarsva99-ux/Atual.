-- https://lua.expert/
local PolicyService = game:GetService("PolicyService")
local LocalPlayer = game:GetService("Players").LocalPlayer
local ok, result = pcall(function() --[[ Line: 4 | Upvalues: PolicyService (copy), LocalPlayer (copy) ]]
	return PolicyService:GetPolicyInfoForPlayerAsync(LocalPlayer)
end)

if not (ok and result) then
	return
end

local t = { "X", "Discord", "YouTube" }
local count = 0

for k, v in pairs(result.AllowedExternalLinkReferences) do
	if table.find(t, v) then
		count = count + 1
	end
end

if not (count < #t) then
	return
end

script.Parent.Text = "See HD Admin\'s description (in Marketplace) for updates"]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item></Item><Item class="UICorner" referent="15299"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>4</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>4</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>4</O></UDim><UDim name="TopRightRadius"><S>0</S><O>4</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item></Item><Item class="UIListLayout" referent="15300"><Properties><UDim name="Padding"><S>0.009999999776482582</S><O>0</O></UDim><token name="HorizontalAlignment">0</token><token name="SortOrder">2</token><token name="VerticalAlignment">0</token><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item><Item class="Frame" referent="15301"><Properties><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">0.9599999785423279</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.11999999731779099</YS><YO>0</YO></UDim2><token name="SizeConstraint">1</token><int name="ZIndex">2003</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[MessageFrame]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="TextLabel" referent="15302"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/familie