752"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

-- https://lua.expert/
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game.ReplicatedStorage
local Lighting = game.Lighting

require(ReplicatedStorage.Modules.RemoteFunction)

local ViewportModel = require(ReplicatedStorage.Modules.ViewportModel)
local Client = require(ReplicatedStorage.Modules.Client)
local LocalPlayer = game.Players.LocalPlayer
local v1 = script.Parent
local Pages = v1.Pages
local Options = v1.Options
local Status = v1.Status
local Wins = v1.Wins
local Equip = ReplicatedStorage.Shop.Events.Equip
local Items = ReplicatedStorage.Shop.Items
local v2 = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In, 0, false, 0)
local v3 = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, 0)
local TemplateSmall = script.TemplateSmall
local TemplateBig = script.TemplateBig
local UIPageLayout = Pages.UIPageLayout
local Click = workspace.Sounds.Click
local v4 = Color3.fromRGB(27, 27, 27)
local v5 = Color3.fromRGB(76, 255, 136)
local t = {
	playerInventory = nil
}

local function Updating() --[[ Updating | Line: 38 | Upvalues: LocalPlayer (copy), Status (copy), Client (copy), Wins (copy) ]]
	if not LocalPlayer:GetAttribute("Coins") then
		return
	end

	Status.Coins.Number.Text = Client.FormatNumber(LocalPlayer:GetAttribute("Coins"))
	Status.Diamonds.Number.Text = Client.FormatNumber(LocalPlayer:GetAttribute("Diamonds"))
	Wins.WinsClassic.Number.Text = LocalPlayer:GetAttribute("ClassicWins")
	Wins.WinsDuo.Number.Text = LocalPlayer:GetAttribute("DuoWins")
	Wins.WinsTeams.Number.Text = LocalPlayer:GetAttribute("TeamsWins")
	Wins.WinsSabotage.Number.Text = LocalPlayer:GetAttribute("SabotageWins")
end

local function UpdateInventory(p1) --[[ UpdateInventory | Line: 50 | Upvalues: t (copy), Items (copy), Pages (copy), TemplateSmall (copy), ViewportModel (copy) ]]
	t.playerInventory = p1

	for v1, v2 in t.playerInventory.Items do
		local v3 = Items:FindFirstChild(v2)

		if v3 and not Pages:FindFirstChild(v2, true) then
			local v4 = TemplateSmall:Clone()

			v4.Name = v2
			v4.Parent = Pages[v3:GetAttribute("Type")]

			local Show = v4.Show
			local Camera = Instance.new("Camera")

			Camera.FieldOfView = 5
			Camera.Parent = Show
			Show.CurrentCamera = Camera

			local v5 = v3:Clone()

			v5.Parent = Show.WorldModel

			local v6 = ViewportModel.new(Show, Camera)
			local v7, _ = v5:GetBoundingBox()

			v6:SetModel(v5)

			local v8 = v6:GetFitDistance(v7.Position)

			Camera.CFrame = CFrame.new(v7.Position) * CFrame.new() * CFrame.new(0, 0, v8)
		end
	end
end

function t.Open() --[[ Open | Line: 84 | Upvalues: v1 (copy), TweenService (copy), v2 (copy) ]]
	v1:SetAttribute("Open", true)
	TweenService:Create(v1, v2, {
		Position = UDim2.new(0.5, 0, 0.52, 0)
	}):Play()
end
function t.Close() --[[ Close | Line: 91 | Upvalues: v1 (copy), TweenService (copy), v3 (copy) ]]
	v1:SetAttribute("Open", false)
	TweenService:Create(v1, v3, {
		Position = UDim2.new(0.5, 0, 1.5, 0)
	}):Play()
end
Pages.DescendantAdded:Connect(function(p1) --[[ Line: 98 | Upvalues: t (copy), v5 (copy), Click (copy), v4 (copy), Equip (copy) ]]
	if p1.ClassName ~= "Frame" then
		return
	end

	if p1.Name == t.playerInventory.Fazendeiro or (p1.Name == t.playerInventory["Lampi\195\163o"] or p1.Name == t.playerInventory.Baia) then
		p1.UIStroke.Color = v5
		p1.LayoutOrder = -1
	end

	p1.Button.MouseButton1Down:Connect(function() --[[ Line: 106 | Upvalues: Click (ref), p1 (copy), v5 (ref), v4 (ref), Equip (ref) ]]
		Click:Play()

		for i, v in ipairs((p1.Parent:GetChildren())) do
			if v.ClassName == "Frame" and v.UIStroke.Color == v5 then
				v.LayoutOrder = 0
				v.UIStroke.Color = v4
			end
		end

		p1.LayoutOrder = -1
		p1.UIStroke.Color = v5
		Equip:FireServer(p1.Name, p1.Parent.Name)
	end)
end)

local Fazendeiro = Options.Fazendeiro

for v6, v7 in Options:GetChildren() do
	if v7.ClassName == "Frame" then
		v7.TextButton.MouseButton1Down:Connect(function() --[[ Line: 130 | Upvalues: Click (copy), Fazendeiro (ref), v4 (copy), v7 (copy), UIPageLayout (copy), Pages (copy) ]]
			Click:Play()
			Fazendeiro.BackgroundColor3 = v4
			Fazendeiro.BackgroundTransparency = 1
			Fazendeiro = v7
			v7.BackgroundColor3 = Color3.fromRGB(33, 49, 30)
			v7.BackgroundTransparency = 0
			UIPageLayout:JumpTo(Pages[v7.Name])
		end)
	end
end

v1.player.Image = game.Players:GetUserThumbnailAsync(game.Players.LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
v1.Text.Text = "@" .. game.Players.LocalPlayer.DisplayName
