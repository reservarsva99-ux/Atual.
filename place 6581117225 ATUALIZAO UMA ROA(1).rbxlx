-- https://lua.expert/
local PolicyService = game:GetService("PolicyService")
local LocalPlayer = game:GetService("Players").LocalPlayer
local ok, result = pcall(function() --[[ Line: 4 | Upvalues: PolicyService (copy), LocalPlayer (copy) ]]
	return PolicyService:GetPolicyInfoForPlayerAsync(LocalPlayer)
end)

if not (ok and result) then
	return
end

local t = { "X", "Discord", "YouTube" }
local count = 0

for k, v in pairs(result.AllowedExternalLinkReferences) do
	if table.find(t, v) then
		count = count + 1
	end
end

if not (count < #t) then
	return
