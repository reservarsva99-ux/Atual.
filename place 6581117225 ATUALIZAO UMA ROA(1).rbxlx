	TweenService:Create(Frame, TweenInfo.new(0.15, Enum.EasingStyle.Bounce), {
		Position = UDim2.new(0.515, 0, 0.55, 0)
	}):Play()
end
function CloseFrame() --[[ CloseFrame | Line: 22 | Upvalues: v4 (ref), TweenService (copy), Frame (copy) ]]
