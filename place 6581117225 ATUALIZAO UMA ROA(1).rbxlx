local function Teleport(p1) --[[ Teleport | Line: 122 | Upvalues: RunService (copy), LocalPlayer (copy) ]]
	RunService:BindToRenderStep("teleporting", Enum.RenderPriority.Character.Value, function() --[[ Line: 123 | Upvalues: LocalPlayer (ref), p1 (copy), RunService (ref) ]]
		local Character = LocalPlayer.Character
