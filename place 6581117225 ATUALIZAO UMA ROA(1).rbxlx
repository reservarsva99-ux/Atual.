end
function GetPlayers(p1) --[[ GetPlayers | Line: 27 | Upvalues: v1 (copy), Frame (copy) ]]
	local v12 = game.Players:GetPlayers()

	for i, v in ipairs(v1) do
		if v12[i] and v12[i]:GetAttribute("Duo") == "" then
			v.Nome.Text = "@" .. v12[i].Name
			v.ImageLabel.Image = game.Players:GetUserThumbnailAsync(v12[i].UserId, "AvatarBust", "Size420x420")
			v.Parent = Frame.ScrollingFrame

			continue
		end

		v.Parent = script
	end
end
