-- https://lua.expert/
local v1 = script.Parent
local LocalPlayer = game.Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

require(ReplicatedStorage.Modules.Client)

local AnimateUI = require(ReplicatedStorage.Modules.AnimateUI)
local v2 = require(LocalPlayer.PlayerScripts.PlayerModule):GetControls()

require(LocalPlayer.PlayerScripts.PlayerModule.CameraModule.BaseCamera)

local CurrentCamera = workspace.CurrentCamera
local Events = ReplicatedStorage.Events
local t = {}

local function Fade(p1, p2) --[[ Fade | Line: 23 | Upvalues: LocalPlayer (copy), v1 (copy), TweenService (copy) ]]
	if not (p2 or LocalPlayer:GetAttribute("isPlaying")) then
		return
	end

	local Fade = v1.Fade

	TweenService:Create(Fade, TweenInfo.new(0.25, Enum.EasingStyle.Circular, Enum.EasingDirection.In), {
		Size = UDim2.new(5, 0, 5, 0)
	}):Play()
	task.wait(p1)
	TweenService:Create(Fade, TweenInfo.new(0.25, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 0, 0, 0)
	}):Play()
end

local function Message(p1, p2, p3, p4) --[[ Message | Line: 32 | Upvalues: v1 (copy), LocalPlayer (copy), Teams (copy), Players (copy), AnimateUI (copy) ]]
	local Message = v1.Message

	Message.Texto.Text = ""
	Message.Person.Visible = false

	if not p3 and (LocalPlayer.Team ~= Teams.Lobby and LocalPlayer.Team ~= Teams["Ro\195\167a"]) then
		return
	end

	if p1 == nil then
		return
	end

	if p4 ~= nil and typeof(p4) == "number" then
		local v12 = Players:GetPlayerByUserId(p4)

		Message.Person.Image = game.Players:GetUserThumbnailAsync(p4, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)

		if v12 then
			Message.Person.PersonName.Text = v12.DisplayName
		else
			Message.Person.PersonName.Text = Players:GetNameFromUserIdAsync(p4)
		end

		Message.Person.Visible = true
	end

	AnimateUI.typeWrite(Message.Texto, p1)
end

local function SetMovement(p1) --[[ SetMovement | Line: 60 | Upvalues: v2 (copy) ]]
	if p1 == false then
		v2:Disable()
		game.StarterGui:SetCore("ResetButtonCallback", false)
	else
		v2:Enable()
		game.StarterGui:SetCore("ResetButtonCallback", true)
	end
end

local function Cutscene(p1, p2, p3, p4) --[[ Cutscene | Line: 70 | Upvalues: LocalPlayer (copy), Teams (copy), t (copy), CurrentCamera (copy), TweenService (copy) ]]
	if p4 == "players" and LocalPlayer.Team == Teams.Lobby then
		return
	end

	if p4 == "ro\195\167a" and LocalPlayer.Team ~= Teams["Ro\195\167a"] then
		return
	end

	if p4 == "ro\195\167a&lobby" and (LocalPlayer.Team ~= Teams["Ro\195\167a"] and LocalPlayer.Team ~= Teams.Lobby) then
		return
	end

	local Cutscene = t.Cutscene

	if Cutscene then
		Cutscene:Cancel()
	end

	if p1 == nil or p2 == nil then
		CurrentCamera.CameraType = Enum.CameraType.Custom
	else
		CurrentCamera.CameraType = Enum.CameraType.Scriptable
		CurrentCamera.CFrame = p1
		t.Cutscene = TweenService:Create(CurrentCamera, TweenInfo.new(p3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
			CFrame = p2
		})
		t.Cutscene:Play()
	end
end

local function FindSeat(p1) --[[ FindSeat | Line: 92 | Upvalues: LocalPlayer (copy), RunService (copy) ]]
	p1.Disabled = false

	local Character = LocalPlayer.Character

	if not (Character and Character.PrimaryPart) then
		return
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local v1 = 0

	RunService:BindToRenderStep("FindSeat", Enum.RenderPriority.Character.Value, function(p12) --[[ Line: 100 | Upvalues: Character (copy), p1 (copy), v1 (ref), Humanoid (copy), RunService (ref) ]]
		v1 = v1 + p12

		if not ((Character.PrimaryPart.Position - p1.Position).Magnitude <= 5 or v1 > 30) or Humanoid.Sit ~= false then
			return
		end

		RunService:UnbindFromRenderStep("FindSeat")
		p1:Sit(Humanoid)
	end)
end

local function PlayerIsSafe() --[[ PlayerIsSafe | Line: 114 ]]
	workspace.House.Door.OPEN.ClickDetector.MaxActivationDistance = 32
	workspace.Outside.Block.CanCollide = false
	task.wait(39.5)
	workspace.House.Door.OPEN.ClickDetector.MaxActivationDistance = 0
	workspace.Outside.Block.CanCollide = true
